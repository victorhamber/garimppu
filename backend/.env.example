# ---------- Endereços (produção: troque pelos seus domínios) ----------
# URL do painel: usada nos links dos e-mails e liberada no CORS.
APP_URL=http://localhost:3000
# URL pública da API: usada na URL do webhook de compra.
API_PUBLIC_URL=http://localhost:8000
# Em produção (HTTPS) o cookie de login precisa ser seguro.
COOKIE_SECURE=false

# ---------- Administrador ----------
# Com as duas preenchidas, a API garante essa conta de admin com essa senha a cada início.
# Para trocar a senha: mude ADMIN_PASSWORD e faça Deploy. Enquanto estiver preenchida, ela vence a troca feita no painel.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---------- Banco ----------
# Produção: Postgres (no EasyPanel, o serviço garimppu-db). Sem esta linha, usa SQLite em data/miner.db.
# Cole a Internal Connection URL do EasyPanel como está (postgres://...).
# DATABASE_URL=postgres://postgres:SENHA@<projeto>_garimppu-db:5432/<projeto>
# REDIS_URL=redis://localhost:6379/0

# ---------- Coleta ----------
# Token da API da Biblioteca de Anúncios (opcional; https://www.facebook.com/ads/library/api)
META_ACCESS_TOKEN=
SCRAPER_HEADLESS=true
DOWNLOAD_VIDEOS=false

# ---------- YouTube (aba Vídeos) ----------
# Chave da YouTube Data API v3 (Google Cloud > APIs e serviços > Credenciais). Sem ela, a busca no YouTube fica desativada.
# Cota grátis: 10.000 unidades/dia; cada coleta de 100 vídeos gasta ~200.
# YOUTUBE_API_KEY=
# YOUTUBE_WINDOW_DAYS=30
# YOUTUBE_MAX_RESULTS=150

# ---------- Webhook e e-mail ----------
# Configure pelo painel em Administração > Webhook de compra e Administração > E-mail.
# As variáveis WEBHOOK_SECRET, WEBHOOK_PRODUCT_IDS e SMTP_* só valem enquanto nada for salvo lá.

# ---------- Pesos do score ----------
SCORE_W_DUPLICATES=1.0
SCORE_W_LONGEVITY=1.0
SCORE_W_PLATFORMS=0.3
SCORE_W_GROWTH=0.5
SCORE_W_PAGE=0.2
