{
  "manifest_version": 3,
  "name": "Garimppu: mineração de anúncios",
  "short_name": "Garimppu",
  "version": "1.5.0",
  "description": "Minera a Biblioteca de Anúncios, o YouTube e o TikTok e envia o que encontrar para o Garimppu.",
  "homepage_url": "https://app.garimppu.com/extensao",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Garimppu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://api.garimppu.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/ads/library*"],
      "js": ["filters.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["yt-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bar.js", "youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://ads.tiktok.com/business/creativecenter/inspiration/topads/*"],
      "js": ["tt-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://ads.tiktok.com/business/creativecenter/inspiration/topads/*"],
      "js": ["bar.js", "tiktok.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.garimppu.com/*"],
      "js": ["app-flag.js"],
      "run_at": "document_start"
    }
  ]
}
