{
  "manifest_version": 3,
  "name": "Garimppu: mineração de anúncios",
  "short_name": "Garimppu",
  "version": "1.2.0",
  "description": "Filtra os anúncios bons da Biblioteca de Anúncios do Meta, baixa os criativos e envia tudo para o Garimppu.",
  "homepage_url": "https://app.garimppu.com/extensao",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Garimppu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://api.garimppu.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/ads/library*"],
      "js": ["filters.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.garimppu.com/*"],
      "js": ["app-flag.js"],
      "run_at": "document_start"
    }
  ]
}
